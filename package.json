{
  "name": "tesla-stammtisch-regensburg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsc && pnpm generate:post-index && vite",
    "build": "tsc && pnpm generate:post-index && pwa-assets-generator && vite build && pnpm generate:static-pages",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "pnpm build && vite preview",
    "generate:post-index": "pnpm dlx tsx generate-post-index.ts",
    "generate:static-pages": "pnpm dlx tsx ssg.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/system": "^9.0.1",
    "@mui/utils": "^9.0.1",
    "ical.js": "^2.2.0",
    "mdi-material-ui": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gray-matter": "^4.0.3",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "tree-kill": "^1.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "^1.0.1",
    "vite-plugin-svgr": "^5.2.0",
    "workbox-window": "^7.3.0"
  }
}
